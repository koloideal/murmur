// Merge into your waybar config:
//   1. add "group/murmur" to "modules-left" (after your first group)
//   2. paste the blocks below into the top-level "modules" object

"group/murmur": {
    "orientation": "horizontal",
    "modules": ["custom/murmur-status", "custom/murmur-clip", "custom/murmur-media"]
},
"custom/murmur-status": {
    "exec": "$HOME/.local/bin/murmur-island.py status-live",
    "return-type": "json",
    "on-click": "kitty --hold $HOME/.local/bin/murmurctl status"
},
"custom/murmur-clip": {
    "exec": "$HOME/.local/bin/murmur-island.py clip-live",
    "return-type": "json",
    "on-click-right": "wl-copy --clear"
},
"custom/murmur-media": {
    "exec": "$HOME/.local/bin/murmur-island.py media-live",
    "return-type": "json",
    "on-click": "$HOME/.local/bin/murmur-player-toggle.sh",
    "on-click-right": "playerctl -p murmur play-pause",
    "on-scroll-up": "$HOME/.local/bin/murmur-player-swipe.sh seek+",
    "on-scroll-down": "$HOME/.local/bin/murmur-player-swipe.sh seek-",
    "on-scroll-right": "$HOME/.local/bin/murmur-player-swipe.sh next",
    "on-scroll-left": "$HOME/.local/bin/murmur-player-swipe.sh previous"
},
